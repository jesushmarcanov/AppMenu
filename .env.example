APP_NAME=AppMenu
APP_ENV=local
APP_DEBUG=true
APP_URL=
APP_BASE_PATH=
APP_TIMEZONE=America/Caracas
SESSION_LIFETIME=7200
UPLOAD_MAX_MB=5
# IPs o rangos CIDR de proxies de confianza (Cloudflare, Nginx...).
# Vacío = usar siempre REMOTE_ADDR e ignorar X-Forwarded-For.
TRUSTED_PROXIES=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=appmenu
DB_USERNAME=root
DB_PASSWORD=

DEFAULT_ADMIN_EMAIL=admin@restaurante.local
DEFAULT_ADMIN_PASSWORD=Admin123!
